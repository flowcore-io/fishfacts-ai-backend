PORT=3033
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/fishfacts_ai_backend

FLOWCORE_TENANT=jbiskur
FLOWCORE_DATA_CORE=fishfacts-ai-backend
FLOWCORE_DATA_CORE_ID=ad37e770-4d43-4ebd-8166-401be5e0b513
FLOWCORE_API_URL=https://webhook.api.flowcore.io
FLOWCORE_API_KEY=fc_replace_with_scoped_key
FLOWCORE_TRANSFORMER_SECRET=replace-with-local-secret
PUMP_RESET_SECRET=replace-with-reset-secret
SERVICE_URL=http://localhost:3033
DISABLE_EVENT_STREAMING=true

USABLE_WORKSPACE_ID=d72eb385-f9cf-43ec-bca5-cc80432877f8
USABLE_API_BASE_URL=https://usable.dev/api
USABLE_API_TOKEN=replace-me
JMELDING_FRAGMENT_TYPE_ID=68505bca-a549-45eb-bca6-965f87195b89
JOB_STATE_FRAGMENT_TYPE_ID=11da02d0-b033-43a4-acd1-96f9e193cc86

JOB_SCHEDULER_ENABLED=false
JOB_SCHEDULER_TICK_MS=30000
JOB_LOCK_TTL_SECONDS=900
FISKERIDIR_JMELDINGER_BASE_URL=https://www.fiskeridir.no/yrkesfiske/j-meldinger
SILDELAGET_CATCHJOURNAL_EXPORT_URL=https://www.sildelaget.no/umbraco/api/catchjournal/ExportCatchJournal

# AIS data — FishFacts read-only MySQL replica via Cloud SQL Connector (public IP)
# Connection auth = Google IAM (service account JSON below) + MySQL user/password.
# Place the cloudsql.client service account key at the GOOGLE_APPLICATION_CREDENTIALS path (gitignored secrets/).
AIS_SOURCE=mysql
AIS_DB_INSTANCE_CONNECTION_NAME=fishfacts-163712:europe-west1:fishfacts-db-mysql-replica
AIS_DB_IP_TYPE=PUBLIC
AIS_DB_USER=usable
AIS_DB_PASSWORD=replace-with-ais-password
AIS_DB_NAME=fishfacts
AIS_DB_MAX_CONNECTIONS=2
GOOGLE_APPLICATION_CREDENTIALS=./secrets/ais-cloudsql-sa.json
AIS_TAIL_LOOKBACK_SECONDS=5
AIS_TAIL_EMIT_CONCURRENCY=8
AIS_BACKFILL_BUCKET_CONCURRENCY=8
AIS_BACKFILL_BATCH_SIZE=500
AIS_PUMP_CONCURRENCY=8

# ClickHouse read model (docker-compose `clickhouse` service locally)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=fishfacts_ais
AIS_CH_BATCH_ROWS=5000
AIS_CH_FLUSH_MS=2000
