{
  "name": "fishfacts-ai-backend",
  "version": "1.7.3",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:migrate:kit": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "services:up": "docker compose up -d postgres",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f postgres",
    "services:reset": "docker compose down -v && docker compose up -d postgres"
  },
  "dependencies": {
    "@flowcore/pathways": "^2.4.2",
    "drizzle-orm": "^0.43.1",
    "exceljs": "^4.4.0",
    "hono": "^4.7.8",
    "jszip": "^3.10.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.12",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3"
  }
}
